{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdantas.net/schema/estilo-1.0.json",
  "title": "Estilo 1.0",
  "description": "Formato aberto de estilo fotográfico do Penumbra (extensões .estilo.json e .estilo.zip; antes Rolo 1.0, cujo format rolo ainda é aceito na leitura). Só dados: nenhum campo é executado. Campos desconhecidos são ignorados pelo leitor (geram aviso, não erro).",
  "type": "object",
  "required": ["format", "version", "id", "name"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "estilo" },
    "version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "base": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$", "description": "id de um estilo de fábrica usado como ponto de partida" },
    "category": { "enum": ["classico", "terror", "outro"] },
    "era": { "type": "integer", "minimum": 1888, "maximum": 2100 },
    "description": { "type": "string", "maxLength": 200 },
    "author": {
      "type": "object",
      "properties": { "name": { "type": "string", "maxLength": 60 } },
      "additionalProperties": false
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[A-Za-z0-9.+() -]{1,40}$", "description": "Identificador SPDX, ex.: CC-BY-4.0" },
    "generator": { "type": "string", "maxLength": 60 },
    "capture": {
      "type": "object",
      "properties": {
        "aspect": { "enum": ["1.33:1", "1.37:1", "1.66:1", "1.85:1", "2.00:1", "2.39:1", "3:4", "9:16", "1:1", "full", "1.33", "1.37", "1.66", "1.85", "2.00", "2.39"] },
        "iso": { "type": "integer", "minimum": 6, "maximum": 12800 },
        "shutter": { "type": "string", "pattern": "^1/\\d{1,4}$" }
      }
    },
    "color": {
      "type": "object",
      "properties": {
        "exposure": { "type": "number", "minimum": -2, "maximum": 2, "default": 0, "description": "EV" },
        "contrast": { "type": "number", "minimum": 0, "maximum": 3, "default": 1 },
        "saturation": { "type": "number", "minimum": 0, "maximum": 4, "default": 1 },
        "hue": { "type": "number", "minimum": -180, "maximum": 180, "default": 0, "description": "graus" },
        "temperature": { "type": "number", "minimum": -100, "maximum": 100, "default": 0 },
        "tint": { "type": "number", "minimum": -100, "maximum": 100, "default": 0, "description": "positivo = magenta" },
        "highlights": { "type": "number", "minimum": -1, "maximum": 1, "default": 0 },
        "shadows": { "type": "number", "minimum": -1, "maximum": 1, "default": 0 },
        "fade": { "type": "number", "minimum": 0, "maximum": 1, "default": 0, "description": "levanta o preto" },
        "curves": {
          "type": "object",
          "properties": {
            "rgb": { "$ref": "#/$defs/curve" },
            "r": { "$ref": "#/$defs/curve" },
            "g": { "$ref": "#/$defs/curve" },
            "b": { "$ref": "#/$defs/curve" }
          },
          "additionalProperties": false
        },
        "split_tone": {
          "type": "object",
          "properties": {
            "shadows": { "$ref": "#/$defs/hex" },
            "highlights": { "$ref": "#/$defs/hex" },
            "balance": { "type": "number", "minimum": -1, "maximum": 1, "default": 0 },
            "amount": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 }
          }
        },
        "lut": {
          "type": "object",
          "required": ["file"],
          "properties": {
            "file": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}\\.cube$", "description": "Arquivo local dentro do mesmo .estilo.zip. URLs e pastas não são aceitas." },
            "mix": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 do .cube; gravado ao empacotar e conferido ao importar." },
            "size": { "type": "integer", "minimum": 2, "maximum": 4096, "description": "Lado da LUT (2-65 em 3D, até 4096 em 1D). Só leitura: preenchido pelo app." },
            "space": { "enum": ["srgb", "rec709", "linear"], "default": "srgb" }
          }
        }
      }
    },
    "film": {
      "type": "object",
      "properties": {
        "grain": {
          "type": "object",
          "properties": {
            "amount": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
            "size": { "type": "number", "minimum": 0.1, "maximum": 5, "default": 1 },
            "roughness": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 }
          }
        },
        "halation": {
          "type": "object",
          "properties": {
            "amount": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
            "radius": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
            "color": { "$ref": "#/$defs/hex" }
          }
        },
        "vignette": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "gate_weave": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "damage": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "flicker": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 }
      }
    },
    "overlays": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["text", "rec_dot", "timestamp"] },
          "text": { "type": "string", "maxLength": 64 },
          "anchor": { "enum": ["top-left", "top-right", "bottom-left", "bottom-right", "center"] },
          "font": { "enum": ["mono", "serif", "sans"] }
        }
      }
    },
    "title_card": {
      "type": "object",
      "properties": {
        "style": { "enum": ["none", "didone-italic", "subtitle"] }
      }
    },
    "x-extensions": { "type": "object", "description": "Espaço livre para ferramentas de terceiros; o app ignora." }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "curve": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "number", "minimum": 0, "maximum": 1 },
          { "type": "number", "minimum": 0, "maximum": 1 }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
